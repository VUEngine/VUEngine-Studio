{
  "private": true,
  "name": "vuengine-studio",
  "description": "Nintendo Virtual Boy game development application",
  "productName": "VUEngine Studio",
  "version": "0.7.0",
  "main": "scripts/ves-electron-main.js",
  "license": "MIT",
  "author": "KR155E <c.radke@posteo.de>",
  "homepage": "https://www.vuengine.dev",
  "bugs": {
    "url": "https://github.com/VUEngine/VUEngine-Studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VUEngine/VUEngine-Studio.git"
  },
  "engines": {
    "yarn": ">=1.7.0 <2",
    "node": ">=12.14.1"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "VUEngine Studio",
        "defaultTheme": "Dark",
        "defaultIconTheme": "vuengine-studio-file-icons",
        "reloadOnReconnect": true,
        "preferences": {
          "files.autoSave": "onFocusChange",
          "workbench.tree.renderIndentGuides": "none",
          "editor.detectIndentation": false,
          "editor.inlayHints.fontSize": 10,
          "editor.insertSpaces": false,
          "editor.rulers": [
            140
          ],
          "files.eol": "\n",
          "files.watcherExclude": {
            "**/.git/objects/**": true,
            "**/.git/subtree-cache/**": true,
            "**/.hg/store/**": true,
            "**/build/working/**": true,
            "**/build/*.a": true,
            "**/build/*.map": true
          },
          "git.autofetch": true,
          "git.repositoryScanMaxDepth": 2,
          "security.workspace.trust.enabled": false,
          "terminal.grouping.mode": "tree",
          "toolbar.showToolbar": true,
          "window.title": "${projectName}",
          "workspace.preserveWindow": true
        },
        "electron": {
          "showWindowEarly": false,
          "splashScreenOptions": {
            "content": "resources/splash/index.html",
            "height": 260,
            "width": 560
          }
        }
      }
    },
    "backend": {
      "config": {
        "frontendConnectionTimeout": -1,
        "resolveSystemPlugins": false,
        "startupTimeout": -1
      }
    }
  },
  "dependencies": {
    "@theia/ai-anthropic": "1.74.0",
    "@theia/ai-chat": "1.74.0",
    "@theia/ai-chat-ui": "1.74.0",
    "@theia/ai-claude-code": "1.74.0",
    "@theia/ai-code-completion": "1.74.0",
    "@theia/ai-codex": "1.74.0",
    "@theia/ai-copilot": "1.74.0",
    "@theia/ai-core": "1.74.0",
    "@theia/ai-core-ui": "1.74.0",
    "@theia/ai-editor": "1.74.0",
    "@theia/ai-google": "1.74.0",
    "@theia/ai-history": "1.74.0",
    "@theia/ai-huggingface": "1.74.0",
    "@theia/ai-ide": "1.74.0",
    "@theia/ai-llamafile": "1.74.0",
    "@theia/ai-mcp": "1.74.0",
    "@theia/ai-mcp-server": "1.74.0",
    "@theia/ai-mcp-ui": "1.74.0",
    "@theia/ai-ollama": "1.74.0",
    "@theia/ai-openai": "1.74.0",
    "@theia/ai-registry": "1.74.0",
    "@theia/ai-scanoss": "1.74.0",
    "@theia/ai-terminal": "1.74.0",
    "@theia/bulk-edit": "1.74.0",
    "@theia/collaboration": "1.74.0",
    "@theia/console": "1.74.0",
    "@theia/core": "1.74.0",
    "@theia/debug": "1.74.0",
    "@theia/editor-preview": "1.74.0",
    "@theia/editor": "1.74.0",
    "@theia/electron": "1.74.0",
    "@theia/external-terminal": "1.74.0",
    "@theia/file-search": "1.74.0",
    "@theia/filesystem": "1.74.0",
    "@theia/keymaps": "1.74.0",
    "@theia/markers": "1.74.0",
    "@theia/messages": "1.74.0",
    "@theia/monaco": "1.74.0",
    "@theia/navigator": "1.74.0",
    "@theia/outline-view": "1.74.0",
    "@theia/output": "1.74.0",
    "@theia/plugin-ext": "1.74.0",
    "@theia/plugin-ext-headless": "1.74.0",
    "@theia/plugin-ext-vscode": "1.74.0",
    "@theia/preferences": "1.74.0",
    "@theia/process": "1.74.0",
    "@theia/property-view": "1.74.0",
    "@theia/scanoss": "1.74.0",
    "@theia/scm-extra": "1.74.0",
    "@theia/scm": "1.74.0",
    "@theia/search-in-workspace": "1.74.0",
    "@theia/secondary-window": "1.74.0",
    "@theia/task": "1.74.0",
    "@theia/terminal-manager": "1.74.0",
    "@theia/terminal": "1.74.0",
    "@theia/timeline": "1.74.0",
    "@theia/toolbar": "1.74.0",
    "@theia/userstorage": "1.74.0",
    "@theia/variable-resolver": "1.74.0",
    "@theia/vsx-registry": "1.74.0",
    "@theia/workspace": "1.74.0",
    "fs-extra": "^9.1.0",
    "terser-webpack-plugin": "^5.3.10",
    "vuengine-studio-extension": "*"
  },
  "devDependencies": {
    "@theia/cli": "1.74.0",
    "@theia/bundle-plugin": "1.74.0",
    "@types/js-yaml": "^3.12.10",
    "@types/yargs": "^17",
    "@wdio/cli": "^6.12.1",
    "@wdio/local-runner": "^6.12.1",
    "@wdio/mocha-framework": "^6.11.0",
    "@wdio/spec-reporter": "^6.11.0",
    "app-builder-lib": "22.10.5",
    "chai": "^4.5.0",
    "concurrently": "^3.6.1",
    "electron": "42.3.0",
    "electron-builder": "23.6.0",
    "electron-chromedriver": "^28.3.3",
    "electron-mocha": "^13.1.0",
    "js-yaml": "^3.14.2",
    "mocha": "^11.0.0",
    "rimraf": "^2.7.1",
    "ts-node": "^10.9.2",
    "wdio-chromedriver-service": "^6.0.4",
    "webdriverio": "^6.12.1",
    "yargs": "^17.7.3"
  },
  "scripts": {
    "clean": "theia clean && rimraf node_modules",
    "clean:dist": "rimraf dist",
    "build": "yarn -s rebuild && theia build --app-target=\"electron\" --mode development",
    "build:prod": "yarn -s rebuild && theia build --app-target=\"electron\"",
    "rebuild": "theia rebuild:electron --cacheRoot .",
    "watch": "concurrently -n compile,build \"theiaext watch --preserveWatchOutput\" \"theia build --watch --mode development\"",
    "start": "electron scripts/ves-electron-main.js --plugins=local-dir:../../plugins",
    "start:debug": "yarn start --log-level=debug",
    "package": "yarn clean:dist && yarn rebuild && electron-builder -c.mac.identity=null --publish never",
    "package:prod": "yarn deploy",
    "deploy": "yarn clean:dist && yarn rebuild && electron-builder -c.mac.identity=null --publish always",
    "package:preview": "yarn clean:dist && yarn rebuild && electron-builder -c.mac.identity=null --dir",
    "update:checksum": "ts-node scripts/update-checksum.ts",
    "update:blockmap": "ts-node scripts/update-blockmap.ts",
    "update:next": "ts-node ../../scripts/update-theia-to-next.ts",
    "test": "mocha --timeout 60000 \"./test/*.spec.js\""
  }
}
